;; Different code, initial global and transient data; same retained record ABI.
(module
  (@custom "icp:private enhanced-orthogonal-persistence" "")
  (import "ic0" "msg_reply_data_append" (func $append (param i32 i32)))
  (import "ic0" "msg_reply" (func $reply))
  (memory (export "memory") 2)
  (global $epoch (mut i64) (i64.const 20))
  (data $transient "\15\00\00\00\00\00\00\00")
  (func $start
    (memory.init $transient (i32.const 64) (i32.const 0) (i32.const 8)))
  (start $start)
  ;; An upgrade must not invoke this fresh-install initializer.
  (func (export "canister_init")
    (i64.store (i32.const 65536) (i64.const 0x4f50524f42453031))
    (i64.store (i32.const 65544) (i64.const 1000)))
  (func (export "canister_post_upgrade")
    (if (i64.ne (i64.load (i32.const 65536)) (i64.const 0x4f50524f42453031))
      (then unreachable)))
  (func (export "canister_update advance")
    (i64.store (i32.const 65544)
      (i64.add (i64.load (i32.const 65544)) (i64.const 1)))
    (call $reply))
  (func (export "canister_query read")
    (i64.store (i32.const 0) (i64.load (i32.const 65536)))
    (i64.store (i32.const 8) (i64.load (i32.const 65544)))
    (i64.store (i32.const 16) (global.get $epoch))
    (i64.store (i32.const 24) (i64.load (i32.const 64)))
    (call $append (i32.const 0) (i32.const 32))
    (call $reply)))
