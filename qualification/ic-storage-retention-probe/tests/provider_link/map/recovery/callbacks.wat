;; Callback exports never call native Rust. Only wrapper boundary functions do.
(global $stage_a (mut i32) (i32.const 0))
(global $stage_b (mut i32) (i32.const 0))
(global $seen_a (mut i32) (i32.const 0))
(global $seen_b (mut i32) (i32.const 0))
(global $recovery_fault (mut i32) (i32.const 0))
(func $frozen
  (call $static_header)
  (call $roots (i64.load (i32.const 65568)) (i64.load (i32.const 65576)))
  (if (i32.ne (global.get $phase) (i32.const 3)) (then unreachable))
  (if (i64.ne (i64.load (i32.const 65584)) (i64.const 2)) (then unreachable)))
(func $boundary (local $frozen i32)
  (call $static_header)
  (local.set $frozen (i64.eq (i64.load (i32.const 65584)) (i64.const 2)))
  (if (local.get $frozen) (then (i64.store (i32.const 65584) (i64.const 1))))
  (global.set $phase (i32.const 1))
  (call $run (i32.const 0) (i64.const 0) (i32.const 0))
  (if (local.get $frozen) (then (i64.store (i32.const 65584) (i64.const 2)) (global.set $phase (i32.const 3)))))
(func (export "__bridge_export")
  (call $boundary)
  (if (i64.gt_u (call $count (i64.load (i32.const 65568))) (i64.const 64)) (then unreachable))
  (if (i64.gt_u (call $count (i64.load (i32.const 65576))) (i64.const 64)) (then unreachable))
  (i64.store (i32.const 65584) (i64.const 2)) (global.set $phase (i32.const 3)))
(func (export "ncp_freeze") (call $frozen))
;; One transient cursor: map_count starts/restarts a root, then callers read
;; key/value pairs in order. No native owner or executable pointer is retained.
(global $read_id (mut i32) (i32.const -1))
(global $read_index (mut i32) (i32.const 0))
(global $read_field (mut i32) (i32.const 0))
(global $read_slot (mut i32) (i32.const 0))
(global $read_visits (mut i32) (i32.const 0))
(func $read_root (param $id i32) (result i64)
  (call $frozen)
  (if (i32.gt_u (local.get $id) (i32.const 1)) (then unreachable))
  (i64.load (i32.add (i32.const 65568) (i32.mul (local.get $id) (i32.const 8)))))
(func $map_count (export "ncp_map_count") (param $id i32) (result i32) (local $root i64)
  (local.set $root (call $read_root (local.get $id)))
  (global.set $read_id (local.get $id))
  (global.set $read_index (i32.const 0)) (global.set $read_field (i32.const 0))
  (global.set $read_slot (i32.const 0)) (global.set $read_visits (i32.const 0))
  (i32.wrap_i64 (call $count (local.get $root))))
(func $map_word (export "ncp_map_word") (param $id i32) (param $index i32) (param $field i32) (result i64)
  (local $root i64) (local $base i32) (local $address i32)
  (local.set $root (call $read_root (local.get $id)))
  (if (i32.ne (local.get $id) (global.get $read_id)) (then unreachable))
  (if (i32.ne (local.get $index) (global.get $read_index)) (then unreachable))
  (if (i32.ne (local.get $field) (global.get $read_field)) (then unreachable))
  (if (i64.ge_u (i64.extend_i32_u (local.get $index)) (call $count (local.get $root))) (then unreachable))
  (local.set $base (i32.add (i32.const 131072) (i32.mul (i32.wrap_i64 (call $start (local.get $root))) (i32.const 24))))
  (if (i32.eqz (local.get $field))
    (then
      (loop $scan
        (if (i64.ge_u (i64.extend_i32_u (global.get $read_slot)) (call $buckets (local.get $root))) (then unreachable))
        (local.set $address (i32.add (local.get $base) (i32.mul (global.get $read_slot) (i32.const 24))))
        (global.set $read_slot (i32.add (global.get $read_slot) (i32.const 1)))
        (global.set $read_visits (i32.add (global.get $read_visits) (i32.const 1)))
        (br_if $scan (i64.eqz (i64.load (local.get $address)))))
      (if (i64.ne (i64.load (local.get $address)) (i64.const 1)) (then unreachable))
      (global.set $read_field (i32.const 1))
      (return (i64.load offset=8 (local.get $address)))))
  ;; The immediately preceding key selected this occupied slot. Reuse its value
  ;; without scanning again; frozen/importing roots cannot mutate mid-read.
  (local.set $address (i32.add (local.get $base) (i32.mul (i32.sub (global.get $read_slot) (i32.const 1)) (i32.const 24))))
  (global.set $read_field (i32.const 0))
  (global.set $read_index (i32.add (local.get $index) (i32.const 1)))
  (i64.load offset=16 (local.get $address)))
(func $fresh (export "ncp_fresh") (local $offset i32)
  (if (i32.ne (global.get $phase) (i32.const 0)) (then unreachable))
  (local.set $offset (i32.const 65536))
  (loop $check
    (if (i64.ne (i64.load (local.get $offset)) (i64.const 0)) (then unreachable))
    (local.set $offset (i32.add (local.get $offset) (i32.const 8)))
    (br_if $check (i32.lt_u (local.get $offset) (i32.const 65616)))))
(func (export "ncp_map_begin") (param $a i32) (param $b i32) (param $fault i32)
  (call $fresh)
  (if (i32.or (i32.gt_u (local.get $a) (i32.const 64)) (i32.gt_u (local.get $b) (i32.const 64))) (then unreachable))
  (if (i32.gt_u (local.get $fault) (i32.const 4)) (then unreachable))
  (global.set $stage_a (local.get $a)) (global.set $stage_b (local.get $b))
  (global.set $seen_a (i32.const 0)) (global.set $seen_b (i32.const 0))
  (global.set $recovery_fault (local.get $fault)) (global.set $phase (i32.const 4)))
(func $stage_address (param $id i32) (param $index i32) (result i32)
  (i32.add (i32.const 66048) (i32.mul (i32.add (i32.mul (local.get $id) (i32.const 64)) (local.get $index)) (i32.const 16))))
(func (export "ncp_map_put") (param $id i32) (param $index i32) (param $key i64) (param $value i64)
  (if (i32.ne (global.get $phase) (i32.const 4)) (then unreachable))
  (if (i32.gt_u (local.get $id) (i32.const 1)) (then unreachable))
  (if (i32.eqz (local.get $id))
    (then
      (if (i32.or (i32.ne (local.get $index) (global.get $seen_a)) (i32.ge_u (local.get $index) (global.get $stage_a))) (then unreachable))
      (global.set $seen_a (i32.add (local.get $index) (i32.const 1))))
    (else
      (if (i32.or (i32.ne (local.get $index) (global.get $seen_b)) (i32.ge_u (local.get $index) (global.get $stage_b))) (then unreachable))
      (global.set $seen_b (i32.add (local.get $index) (i32.const 1)))))
  (i64.store (call $stage_address (local.get $id) (local.get $index)) (local.get $key))
  (i64.store offset=8 (call $stage_address (local.get $id) (local.get $index)) (local.get $value)))
(func (export "ncp_map_finish")
  (if (i32.ne (global.get $phase) (i32.const 4)) (then unreachable))
  (if (i32.or (i32.ne (global.get $seen_a) (global.get $stage_a)) (i32.ne (global.get $seen_b) (global.get $stage_b))) (then unreachable))
  (global.set $phase (i32.const 5)))
;; This wrapper runs only after all checkpoint Rust frames and owners have ended.
(func $build_map (param $id i32) (param $count i32) (local $index i32) (local $address i32)
  (block $done
    (loop $build
      (br_if $done (i32.eq (local.get $index) (local.get $count)))
      (local.set $address (call $stage_address (local.get $id) (local.get $index)))
      (call $run_pair (i32.or (i32.const 1) (i32.shl (local.get $id) (i32.const 8)))
        (i64.load (local.get $address)) (i64.load offset=8 (local.get $address)) (i32.const 0))
      (if (i32.eq (global.get $recovery_fault) (i32.const 3)) (then unreachable))
      (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $build))))
(func (export "__bridge_post")
  (if (i32.eq (global.get $phase) (i32.const 5))
    (then
      (call $native_init)
      (call $build_map (i32.const 0) (global.get $stage_a))
      (call $build_map (i32.const 1) (global.get $stage_b))
      (if (i32.ne (i32.wrap_i64 (call $count (i64.load (i32.const 65568)))) (global.get $stage_a)) (then unreachable))
      (if (i32.ne (i32.wrap_i64 (call $count (i64.load (i32.const 65576)))) (global.get $stage_b)) (then unreachable))
      (if (i32.eq (global.get $recovery_fault) (i32.const 4)) (then unreachable)))
    (else (call $boundary))))
(func (export "canister_update full_width")
  (call $run_pair (i32.const 1) (i64.const -1) (i64.const -2) (i32.const 0))
  (call $run_pair (i32.const 257) (i64.const -2) (i64.const -1) (i32.const 0)) (call $reply))
(func (export "canister_update fill_checkpoint")
  (call $run_pair (i32.const 11) (i64.const 0) (i64.const 63) (i32.const 0))
  (call $run_pair (i32.const 267) (i64.const 0) (i64.const 63) (i32.const 0)) (call $reply))
(func (export "canister_update damage_native")
  (call $frozen) (i64.store (i32.const 65536) (i64.const 0)) (call $reply))
