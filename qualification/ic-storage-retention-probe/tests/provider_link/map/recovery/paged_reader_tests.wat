;; Query-only callback counterexamples: synthesize provider state without any
;; Rust frame or native loan. Query mutations are discarded; installed batch
;; tests separately exercise the callback with real owners and rollback.
(func $reader_probe (param $mode i32) (local $id i32)
  (if (i32.eq (local.get $mode) (i32.const 2))
    (then (drop (call $staged_word (i32.const 0) (i32.const 0))) (call $reply) (return)))
  (local.set $id (i32.eq (local.get $mode) (i32.const 1)))
  (global.set $phase (i32.const 2)) (i64.store (i32.const 65584) (i64.const 0))
  (global.set $pending (i32.const 2)) (global.set $committing (i32.const 0))
  (global.set $page_id (local.get $id)) (global.set $page_count (i32.const 1))
  (global.set $page_index (i32.const 0)) (global.set $page_field (i32.const 0))
  (global.set $operation (i32.or (i32.const 13) (i32.shl (local.get $id) (i32.const 8))))
  (global.set $stage_a (i32.eqz (local.get $id))) (global.set $stage_b (local.get $id))
  (global.set $seen_a (global.get $stage_a)) (global.set $seen_b (global.get $stage_b))
  (global.set $recovery_fault (i32.const 0))
  (i64.store (call $stage_address (local.get $id) (i32.const 0)) (i64.const -1))
  (i64.store offset=8 (call $stage_address (local.get $id) (i32.const 0)) (i64.const -2))
  (if (i32.eq (local.get $mode) (i32.const 3)) (then (global.set $phase (i32.const 1))))
  (if (i32.eq (local.get $mode) (i32.const 4)) (then (i64.store (i32.const 65584) (i64.const 1))))
  (if (i32.eq (local.get $mode) (i32.const 5)) (then (global.set $pending (i32.const 0))))
  (if (i32.eq (local.get $mode) (i32.const 6)) (then (global.set $committing (i32.const 1))))
  (if (i32.eq (local.get $mode) (i32.const 7)) (then (global.set $page_id (i32.const 2))))
  (if (i32.eq (local.get $mode) (i32.const 8)) (then (global.set $operation (i32.const 269))))
  (if (i32.eq (local.get $mode) (i32.const 9)) (then (global.set $page_count (i32.const 65))))
  (if (i32.eq (local.get $mode) (i32.const 10)) (then (global.set $seen_a (i32.const 0))))
  (if (i32.eq (local.get $mode) (i32.const 11)) (then (global.set $stage_b (i32.const 64)) (global.set $seen_b (i32.const 64))))
  (if (i32.eq (local.get $mode) (i32.const 17)) (then (global.set $page_count (i32.const 0))))
  (if (i32.eq (local.get $mode) (i32.const 18)) (then (global.set $page_count (i32.const 2))))
  (if (i32.eq (local.get $mode) (i32.const 21)) (then (global.set $stage_b (i32.const -1)) (global.set $seen_b (i32.const -1))))
  (if (i32.eq (local.get $mode) (i32.const 12)) (then (drop (call $staged_word (i32.const 1) (i32.const 0))) (call $reply) (return)))
  (if (i32.eq (local.get $mode) (i32.const 13)) (then (drop (call $staged_word (i32.const 0) (i32.const 1))) (call $reply) (return)))
  (if (i32.eq (local.get $mode) (i32.const 20)) (then (drop (call $staged_word (i32.const 0) (i32.const 3))) (call $reply) (return)))
  (if (i64.ne (call $staged_word (i32.const 0) (i32.const 0)) (i64.const -1)) (then unreachable))
  (if (i32.eq (local.get $mode) (i32.const 14)) (then (drop (call $staged_word (i32.const 0) (i32.const 0))) (call $reply) (return)))
  (if (i32.eq (local.get $mode) (i32.const 15)) (then (drop (call $staged_word (i32.const 0) (i32.const 2))) (call $reply) (return)))
  (if (i64.ne (call $staged_word (i32.const 0) (i32.const 1)) (i64.const -2)) (then unreachable))
  (if (i64.ne (call $staged_word (i32.const 0) (i32.const 2)) (i64.const 0)) (then unreachable))
  (if (i32.eq (local.get $mode) (i32.const 16)) (then (drop (call $staged_word (i32.const 1) (i32.const 0)))))
  (if (i32.eq (local.get $mode) (i32.const 19))
    (then (global.set $phase (i32.const 1)) (drop (call $staged_word (i32.const 0) (i32.const 0)))))
  (call $reply))
