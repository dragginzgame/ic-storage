;; Installed-only evidence endpoints. Scratch is outside native metadata, staging
;; and both retained pools. Queries do not persist cursor or scratch mutations.
(func $read_test_map (param $id i32) (local $count i32) (local $index i32)
  (local.set $count (call $map_count (local.get $id)))
  (i64.store (i32.const 69000) (i64.extend_i32_u (local.get $count)))
  (call $reply_data (i32.const 69000) (i32.const 8))
  (block $done
    (loop $records
      (br_if $done (i32.eq (local.get $index) (local.get $count)))
      (i64.store (i32.const 69000) (call $map_word (local.get $id) (local.get $index) (i32.const 0)))
      (i64.store (i32.const 69008) (call $map_word (local.get $id) (local.get $index) (i32.const 1)))
      (call $reply_data (i32.const 69000) (i32.const 16))
      (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $records)))
  (i64.store (i32.const 69000) (i64.extend_i32_u (global.get $read_visits)))
  (call $reply_data (i32.const 69000) (i32.const 8)))
(func (export "canister_query scan_records")
  (call $read_test_map (i32.const 0)) (call $read_test_map (i32.const 1)) (call $reply))
(func (export "canister_update scan_unstarted")
  (global.set $read_id (i32.const -1))
  (drop (call $map_word (i32.const 0) (i32.const 0) (i32.const 0))) (call $reply))
(func (export "canister_update scan_wrong_root")
  (drop (call $map_count (i32.const 0)))
  (drop (call $map_word (i32.const 1) (i32.const 0) (i32.const 0))) (call $reply))
(func (export "canister_update scan_invalid_root")
  (drop (call $map_count (i32.const 2))) (call $reply))
(func (export "canister_update scan_value_first")
  (drop (call $map_count (i32.const 0)))
  (drop (call $map_word (i32.const 0) (i32.const 0) (i32.const 1))) (call $reply))
(func (export "canister_update scan_invalid_field")
  (drop (call $map_count (i32.const 0)))
  (drop (call $map_word (i32.const 0) (i32.const 0) (i32.const 2))) (call $reply))
(func (export "canister_update scan_skip")
  (drop (call $map_count (i32.const 0)))
  (drop (call $map_word (i32.const 0) (i32.const 1) (i32.const 0))) (call $reply))
(func (export "canister_update scan_repeat_key")
  (drop (call $map_count (i32.const 0)))
  (drop (call $map_word (i32.const 0) (i32.const 0) (i32.const 0)))
  (drop (call $map_word (i32.const 0) (i32.const 0) (i32.const 0))) (call $reply))
(func (export "canister_update scan_repeat_record")
  (drop (call $map_count (i32.const 0)))
  (drop (call $map_word (i32.const 0) (i32.const 0) (i32.const 0)))
  (drop (call $map_word (i32.const 0) (i32.const 0) (i32.const 1)))
  (drop (call $map_word (i32.const 0) (i32.const 0) (i32.const 0))) (call $reply))
(func (export "canister_update scan_past_end") (local $count i32) (local $index i32)
  (local.set $count (call $map_count (i32.const 0)))
  (block $done
    (loop $records
      (br_if $done (i32.eq (local.get $index) (local.get $count)))
      (drop (call $map_word (i32.const 0) (local.get $index) (i32.const 0)))
      (drop (call $map_word (i32.const 0) (local.get $index) (i32.const 1)))
      (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $records)))
  (drop (call $map_word (i32.const 0) (local.get $count) (i32.const 0))) (call $reply))
(func (export "canister_query scan_restart") (local $key i64)
  (drop (call $map_count (i32.const 0)))
  (local.set $key (call $map_word (i32.const 0) (i32.const 0) (i32.const 0)))
  (drop (call $map_count (i32.const 1)))
  (drop (call $map_count (i32.const 0)))
  (if (i64.ne (local.get $key) (call $map_word (i32.const 0) (i32.const 0) (i32.const 0))) (then unreachable))
  (drop (call $map_word (i32.const 0) (i32.const 0) (i32.const 1))) (call $reply))
(func (export "canister_update sparsify_checkpoint") (local $key i64)
  (loop $remove
    (call $run_pair (i32.const 2) (local.get $key) (i64.add (local.get $key) (i64.const 1000)) (i32.const 0))
    (call $run_pair (i32.const 258) (local.get $key) (i64.add (local.get $key) (i64.const 1000)) (i32.const 0))
    (local.set $key (i64.add (local.get $key) (i64.const 1)))
    (br_if $remove (i64.lt_u (local.get $key) (i64.const 62)))) (call $reply))
