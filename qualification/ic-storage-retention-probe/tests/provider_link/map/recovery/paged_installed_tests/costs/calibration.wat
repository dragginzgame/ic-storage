    (drop (memory.grow (i32.const 1)))
    (drop (call $grow (i64.const 1)))
    (i64.store (i32.const 128) (i64.const 12345))
    (call $write (i64.const 0) (i64.const 128) (i64.const 8))
    (call $read (i64.const 256) (i64.const 0) (i64.const 8))
    (if (i64.ne (i64.load (i32.const 256)) (i64.const 12345)) (then unreachable)))
  (func (export "canister_update work") (call $work) (call $reply))
  (func (export "canister_update fail") (call $work) unreachable)
  (func (export "canister_update empty") (call $reply)))
