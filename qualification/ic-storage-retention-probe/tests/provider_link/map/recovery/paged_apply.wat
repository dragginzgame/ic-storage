;; The provider serves scalar staging reads while native Rust owns the pool.
;; It neither reads native slots nor calls Rust. Checkpoint Rust already ended.
(global $page_id (mut i32) (i32.const -1))
(global $page_count (mut i32) (i32.const 0))
(global $page_index (mut i32) (i32.const 0))
(global $page_field (mut i32) (i32.const 0))
(func $staged_word (param $index i32) (param $field i32) (result i64)
  (if (i32.ne (global.get $phase) (i32.const 2)) (then unreachable))
  (if (i64.ne (i64.load (i32.const 65584)) (i64.const 0)) (then unreachable))
  (if (i32.or (i32.ne (global.get $pending) (i32.const 2)) (global.get $committing)) (then unreachable))
  (if (i32.gt_u (global.get $page_id) (i32.const 1)) (then unreachable))
  (if (i32.ne (global.get $operation) (i32.or (i32.const 13) (i32.shl (global.get $page_id) (i32.const 8)))) (then unreachable))
  (if (i32.or (i32.eqz (global.get $page_count)) (i32.gt_u (global.get $page_count) (i32.const 64))) (then unreachable))
  (if (i32.ne (global.get $page_count) (select (global.get $stage_a) (global.get $stage_b) (i32.eqz (global.get $page_id)))) (then unreachable))
  (if (i32.or (i32.gt_u (global.get $stage_a) (i32.const 64)) (i32.gt_u (global.get $stage_b) (i32.const 64))) (then unreachable))
  (if (i32.gt_u (i32.add (global.get $stage_a) (global.get $stage_b)) (i32.const 64)) (then unreachable))
  (if (i32.or (i32.ne (global.get $seen_a) (global.get $stage_a)) (i32.ne (global.get $seen_b) (global.get $stage_b))) (then unreachable))
  (if (i32.or (i32.ne (local.get $index) (global.get $page_index)) (i32.ge_u (local.get $index) (global.get $page_count))) (then unreachable))
  (if (i32.or (i32.ne (local.get $field) (global.get $page_field)) (i32.gt_u (local.get $field) (i32.const 2))) (then unreachable))
  (if (i32.lt_u (local.get $field) (i32.const 2))
    (then
      (global.set $page_field (i32.add (local.get $field) (i32.const 1)))
      (return (i64.load (i32.add (call $stage_address (global.get $page_id) (local.get $index)) (i32.mul (local.get $field) (i32.const 8)))))))
  ;; Acknowledgement occurs after an actual insertion, with both owners live.
  (if (i32.eq (global.get $recovery_fault) (i32.const 3)) (then unreachable))
  (global.set $page_index (i32.add (local.get $index) (i32.const 1)))
  (global.set $page_field (i32.const 0))
  (i64.const 0))
(func $apply_page (param $id i32) (param $count i32)
  (if (i32.eqz (local.get $count)) (then (return)))
  (if (i32.or (i32.gt_u (local.get $id) (i32.const 1)) (i32.gt_u (local.get $count) (i32.const 64))) (then unreachable))
  (if (i32.ne (global.get $page_id) (i32.const -1)) (then unreachable))
  (global.set $page_id (local.get $id)) (global.set $page_count (local.get $count))
  (global.set $page_index (i32.const 0)) (global.set $page_field (i32.const 0))
  (call $run_pair (i32.or (i32.const 13) (i32.shl (local.get $id) (i32.const 8)))
    (i64.extend_i32_u (local.get $count)) (i64.const 0) (i32.const 0))
  (if (i32.or (i32.ne (global.get $page_index) (local.get $count)) (global.get $page_field)) (then unreachable))
  (global.set $page_id (i32.const -1)) (global.set $page_count (i32.const 0)))
