;; Job-specific native format. The stable locator never inherits a bare checkpoint.
(func (export "ncp_domain") (result i64) (i64.const 131072))
(func (export "__bridge_frozen") (call $boundary) (call $frozen))
(func (export "__bridge_cancel") (call $boundary))
(func (export "ncp_thaw") (param $retry i32)
  (call $static_header)
  (if (i32.eqz (local.get $retry))
    (then
      (call $frozen)
      (i64.store (i32.const 65584) (i64.const 1))
      (global.set $phase (i32.const 1)))
    (else
      (if (i32.ne (local.get $retry) (i32.const 1)) (then unreachable))
      (if (i32.ne (global.get $phase) (i32.const 1)) (then unreachable))
      (if (i64.ne (i64.load (i32.const 65584)) (i64.const 1)) (then unreachable)))))
;; Stable native settlement: 1=active, 2=frozen source, 3=private import prefix.
;; Each native admission finishes before any checkpoint Rust or stack reset.
(func $boundary (local $state i64)
  (call $static_header)
  (local.set $state (i64.load (i32.const 65584)))
  (if (i32.or (i64.lt_u (local.get $state) (i64.const 1)) (i64.gt_u (local.get $state) (i64.const 3))) (then unreachable))
  (i64.store (i32.const 65584) (i64.const 1))
  (global.set $phase (i32.const 1))
  (call $run (i32.const 0) (i64.const 0) (i32.const 0))
  (i64.store (i32.const 65584) (local.get $state))
  (if (i64.eq (local.get $state) (i64.const 2)) (then (global.set $phase (i32.const 3))))
  (if (i64.eq (local.get $state) (i64.const 3)) (then (global.set $phase (i32.const 6)))))
(func $importing (export "ncp_map_stage_state")
  (call $static_header)
  (call $roots (i64.load (i32.const 65568)) (i64.load (i32.const 65576)))
  (if (i32.ne (global.get $phase) (i32.const 6)) (then unreachable))
  (if (i64.ne (i64.load (i32.const 65584)) (i64.const 3)) (then unreachable)))
(func $readable
  (if (i32.eq (global.get $phase) (i32.const 6)) (then (call $importing)) (else (call $frozen))))
(func (export "__bridge_importing") (call $boundary) (call $importing))
(func (export "ncp_stage_ready")
  (call $admit)
  (if (i32.ne (global.get $phase) (i32.const 1)) (then unreachable)))

;; These globals and scalar staging bytes are transient per request. Only native
;; roots/settlement and the independent stable job cursor survive interruption.
(global $pending (mut i32) (i32.const 0))
(global $complete (mut i32) (i32.const 0))
(global $expected_a (mut i32) (i32.const 0))
(global $expected_b (mut i32) (i32.const 0))
(func (export "ncp_map_stage_start") (param $fault i32)
  (call $fresh)
  (if (i32.ne (global.get $pending) (i32.const 0)) (then unreachable))
  (if (i32.gt_u (local.get $fault) (i32.const 3)) (then unreachable))
  (global.set $recovery_fault (local.get $fault))
  (global.set $pending (i32.const 1)))
(func (export "ncp_map_stage_prepare") (param $a i32) (param $b i32) (param $complete i32) (param $fault i32)
  (call $importing)
  (if (i32.ne (global.get $pending) (i32.const 0)) (then unreachable))
  (if (i32.or (i32.gt_u (local.get $a) (i32.const 64)) (i32.gt_u (local.get $b) (i32.const 64))) (then unreachable))
  (if (i32.gt_u (i32.add (local.get $a) (local.get $b)) (i32.const 64)) (then unreachable))
  (if (i32.or (i32.gt_u (local.get $complete) (i32.const 1)) (i32.gt_u (local.get $fault) (i32.const 4))) (then unreachable))
  (global.set $expected_a (i32.add (i32.wrap_i64 (call $count (i64.load (i32.const 65568)))) (local.get $a)))
  (global.set $expected_b (i32.add (i32.wrap_i64 (call $count (i64.load (i32.const 65576)))) (local.get $b)))
  (if (i32.or (i32.gt_u (global.get $expected_a) (i32.const 64)) (i32.gt_u (global.get $expected_b) (i32.const 64))) (then unreachable))
  (global.set $stage_a (local.get $a)) (global.set $stage_b (local.get $b))
  (global.set $seen_a (i32.const 0)) (global.set $seen_b (i32.const 0))
  (global.set $complete (local.get $complete)) (global.set $recovery_fault (local.get $fault))
  (global.set $phase (i32.const 4)) (global.set $pending (i32.const 2)))
(func $suspend_import
  (i64.store (i32.const 65584) (i64.const 3)) (global.set $phase (i32.const 6)))
(func $stage_apply (export "__bridge_stage_apply")
  (if (i32.eq (global.get $pending) (i32.const 1))
    (then
      (call $native_init)
      (if (i32.eq (global.get $recovery_fault) (i32.const 2)) (then unreachable))
      (call $suspend_import)
      (if (i32.eq (global.get $recovery_fault) (i32.const 3)) (then unreachable))))
  (if (i32.eq (global.get $pending) (i32.const 2))
    (then
      (if (i32.ne (global.get $phase) (i32.const 5)) (then unreachable))
      (if (i64.ne (i64.load (i32.const 65584)) (i64.const 3)) (then unreachable))
      (i64.store (i32.const 65584) (i64.const 1)) (global.set $phase (i32.const 1))
      (call $build_map (i32.const 0) (global.get $stage_a))
      (call $build_map (i32.const 1) (global.get $stage_b))
      (if (i32.ne (i32.wrap_i64 (call $count (i64.load (i32.const 65568)))) (global.get $expected_a)) (then unreachable))
      (if (i32.ne (i32.wrap_i64 (call $count (i64.load (i32.const 65576)))) (global.get $expected_b)) (then unreachable))
      (if (i32.eqz (global.get $complete)) (then (call $suspend_import)))
      (if (i32.eq (global.get $recovery_fault) (i32.const 4)) (then unreachable))))
  (global.set $pending (i32.const 0)))
(func (export "__bridge_batch_before")
  (if (i32.ne (global.get $pending) (i32.const 0)) (then unreachable))
  (call $boundary)
  (if (i32.eq (global.get $phase) (i32.const 3)) (then unreachable)))
(func (export "__bridge_batch_after") (call $stage_apply) (call $reply))
(func (export "ncp_map_stage_damage") (param $mode i32) (local $slot i32) (local $address i32) (local $root i64)
  (call $importing)
  (if (i32.eq (local.get $mode) (i32.const 0))
    (then (i64.store (i32.const 65536) (i64.const 0)) (return)))
  (if (i32.eq (local.get $mode) (i32.const 2))
    (then (i64.store (i32.const 65584) (i64.const 0)) (return)))
  (if (i32.ne (local.get $mode) (i32.const 1)) (then unreachable))
  (local.set $root (i64.load (i32.const 65568)))
  (if (i64.eqz (call $count (local.get $root))) (then (local.set $root (i64.load (i32.const 65576)))))
  (if (i64.eqz (call $count (local.get $root))) (then unreachable))
  (loop $scan
    (if (i64.ge_u (i64.extend_i32_u (local.get $slot)) (call $buckets (local.get $root))) (then unreachable))
    (local.set $address (i32.add (i32.const 131072) (i32.mul (i32.add (i32.wrap_i64 (call $start (local.get $root))) (local.get $slot)) (i32.const 24))))
    (if (i64.eq (i64.load (local.get $address)) (i64.const 1))
      (then (i64.store offset=16 (local.get $address) (i64.xor (i64.load offset=16 (local.get $address)) (i64.const 1))) (return)))
    (local.set $slot (i32.add (local.get $slot) (i32.const 1))) (br $scan)))
