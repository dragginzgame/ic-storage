;; Closed scalar-map provider. Root words: magic, format, base, extent, count,
;; buckets, settlement, Slot stride, alignment, hash/probe version, active bank.
(module
  (@custom "icp:private enhanced-orthogonal-persistence" "")
  (import "ic0" "msg_reply_data_append" (func $reply_data (param i32 i32)))
  (import "ic0" "msg_reply" (func $reply))
  (import "vector_link" "step" (func $native_step (param i32 i32 i32 i64) (result i64)))
  (memory (export "memory") 3 3)
  (global $version i64 (i64.const __VERSION__))
  (global $phase (mut i32) (i32.const 0))
  (global $operation (mut i32) (i32.const -1))

  (func $shape (param $count i64) (param $buckets i64)
    (if (i64.lt_u (local.get $buckets) (i64.const 8)) (then unreachable))
    (if (i64.gt_u (local.get $buckets) (i64.const 512)) (then unreachable))
    (if (i64.ne (i64.and (local.get $buckets) (i64.sub (local.get $buckets) (i64.const 1))) (i64.const 0)) (then unreachable))
    (if (i64.gt_u (local.get $count) (i64.sub (local.get $buckets) (i64.shr_u (local.get $buckets) (i64.const 2)))) (then unreachable)))

  (func $static_header
    (if (i32.ne (memory.size) (i32.const 3)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65536)) (i64.const 0x3130303050414d4e)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65544)) (i64.const 2)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65552)) (i64.const 131072)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65560)) (i64.const 24576)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65592)) (i64.const 24)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65600)) (i64.const 8)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65608)) (i64.const 1)) (then unreachable))
    (if (i64.gt_u (i64.load (i32.const 65616)) (i64.const 1)) (then unreachable)))

  (func $admit
    (call $static_header)
    (if (i64.ne (i64.load (i32.const 65584)) (i64.const 1)) (then unreachable))
    (call $shape (i64.load (i32.const 65568)) (i64.load (i32.const 65576))))

  (func $claim (result i32)
    (if (i32.ne (global.get $phase) (i32.const 1)) (then unreachable))
    (call $admit)
    (i64.store (i32.const 65584) (i64.const 0))
    (global.set $phase (i32.const 2))
    (i32.const 131072))

  (func $settle (param $count i64) (param $buckets i64) (param $bank i64)
    (if (i32.ne (global.get $phase) (i32.const 2)) (then unreachable))
    (call $static_header)
    (if (i64.ne (i64.load (i32.const 65584)) (i64.const 0)) (then unreachable))
    (call $shape (local.get $count) (local.get $buckets))
    (if (i64.gt_u (local.get $bank) (i64.const 1)) (then unreachable))
    (if (i64.eq (local.get $bank) (i64.load (i32.const 65616)))
      (then (if (i64.ne (local.get $buckets) (i64.load (i32.const 65576))) (then unreachable)))
      (else
        (if (i64.ne (i64.load (i32.const 65568))
          (i64.sub (i64.load (i32.const 65576)) (i64.shr_u (i64.load (i32.const 65576)) (i64.const 2)))) (then unreachable))
        (if (i64.ne (local.get $buckets) (i64.mul (i64.load (i32.const 65576)) (i64.const 2))) (then unreachable))
        (if (i64.ne (local.get $count) (i64.add (i64.load (i32.const 65568)) (i64.const 1))) (then unreachable))))
    (i64.store (i32.const 65568) (local.get $count))
    (i64.store (i32.const 65576) (local.get $buckets))
    (i64.store (i32.const 65616) (local.get $bank))
    (i64.store (i32.const 65584) (i64.const 1))
    (global.set $phase (i32.const 1)))

  (func $run (param $operation i32) (param $argument i64) (param $fail i32) (local $root i64)
    (if (i32.ne (global.get $operation) (i32.const -1)) (then unreachable))
    (call $admit)
    (global.set $operation (local.get $operation))
    (local.set $root (call $native_step
      (i32.wrap_i64 (i64.load (i32.const 65568)))
      (i32.or (i32.wrap_i64 (i64.load (i32.const 65576)))
        (i32.shl (i32.wrap_i64 (i64.load (i32.const 65616))) (i32.const 16)))
      (local.get $operation) (local.get $argument)))
    ;; The actual Rust owner has ended. Publication and settlement follow return.
    (if (i32.eq (local.get $fail) (i32.const 1)) (then unreachable))
    (call $settle (i64.shr_u (local.get $root) (i64.const 32))
      (i64.and (local.get $root) (i64.const 0xffff))
      (i64.and (i64.shr_u (local.get $root) (i64.const 16)) (i64.const 0xffff)))
    (if (i32.eq (local.get $fail) (i32.const 2)) (then unreachable))
    (global.set $operation (i32.const -1)))

  (func (export "canister_init")
    (memory.fill (i32.const 131072) (i32.const 0) (i32.const 24576))
    (i64.store (i32.const 65536) (i64.const 0x3130303050414d4e))
    (i64.store (i32.const 65544) (i64.const 2))
    (i64.store (i32.const 65552) (i64.const 131072))
    (i64.store (i32.const 65560) (i64.const 24576))
    (i64.store (i32.const 65568) (i64.const 0))
    (i64.store (i32.const 65576) (i64.const __BUCKETS__))
    (i64.store (i32.const 65584) (i64.const 1))
    (i64.store (i32.const 65592) (i64.const 24))
    (i64.store (i32.const 65600) (i64.const 8))
    (i64.store (i32.const 65608) (i64.const 1))
    (i64.store (i32.const 65616) (i64.const 0))
    (global.set $phase (i32.const 1))
    (call $run (i32.const 0) (i64.const 0) (i32.const 0)))

  (func __PRE_EXPORT__
    (if (i32.ne (global.get $phase) (i32.const 1)) (then unreachable))
    (call $run (i32.const 0) (i64.const 0) (i32.const 0)))
  (func (export "canister_post_upgrade")
    (call $admit)
    (global.set $phase (i32.const 1))
    (call $run (i32.const 0) (i64.const 0) (i32.const 0))
    __POST_FAILURE__)

  (func (export "canister_update fill") (local $key i64) (local $limit i64)
    (call $run (i32.const 8) (i64.const 0) (i32.const 0))
    (local.set $limit (i64.mul (i64.shr_u (i64.load (i32.const 65576)) (i64.const 2)) (i64.const 3)))
    (loop $fill
      (call $run (i32.const 1)
        (i64.or (local.get $key) (i64.shl (i64.add (local.get $key) (i64.const 1000)) (i64.const 32))) (i32.const 0))
      (local.set $key (i64.add (local.get $key) (i64.const 1)))
      (br_if $fill (i64.lt_u (local.get $key) (local.get $limit))))
    (call $reply))

  (func (export "canister_update duplicate_claim") (drop (call $claim)) (drop (call $claim)) (call $reply))
  (func (export "canister_update settle_without_claim") (call $settle (i64.const 0) (i64.const 8) (i64.const 0)) (call $reply))
  (func (export "canister_update corrupt") __FAULT__ (call $reply))
  (func (export "canister_query observe")
    (i64.store (i32.const 0) (global.get $version))
    (i64.store (i32.const 8) (i64.extend_i32_u (global.get $phase)))
    (call $reply_data (i32.const 0) (i32.const 16))
    (call $reply_data (i32.const 65536) (i32.const 88))
    (call $reply_data (i32.const 131072) (i32.const 24576))
    (call $reply))
  __HELPERS_AND_METHODS__
)
