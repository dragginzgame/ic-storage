;; Two native map roots in one provider-owned growable pool. Root descriptors
;; encode count:12, log2(buckets):4, start:16. Only the idle provider grows memory.
(module
  (@custom "icp:private enhanced-orthogonal-persistence" "")
  (import "ic0" "msg_reply_data_append" (func $reply_data (param i32 i32)))
  (import "ic0" "msg_reply" (func $reply))
  (import "vector_link" "step" (func $native_step (param i32 i32 i32 i64 i64) (result i64)))
  (memory (export "memory") 3 __MAX_PAGES__)
  (global $version i64 (i64.const __VERSION__))
  (global $phase (mut i32) (i32.const 0))
  (global $operation (mut i32) (i32.const -1))
  (global $failure (mut i32) (i32.const 0))
  (func $elements (result i64) (i64.div_u (i64.load (i32.const 65560)) (i64.const 24)))
  (func $start (param $root i64) (result i64) (i64.shr_u (local.get $root) (i64.const 16)))
  (func $exponent (param $root i64) (result i64) (i64.and (i64.shr_u (local.get $root) (i64.const 12)) (i64.const 15)))
  (func $buckets (param $root i64) (result i64) (i64.shl (i64.const 1) (call $exponent (local.get $root))))
  (func $count (param $root i64) (result i64) (i64.and (local.get $root) (i64.const 4095)))
  (func $shape (param $root i64) (local $buckets i64)
    (if (i64.gt_u (local.get $root) (i64.const 0xffffffff)) (then unreachable))
    (if (i64.lt_u (call $exponent (local.get $root)) (i64.const 3)) (then unreachable))
    (if (i64.gt_u (call $exponent (local.get $root)) (i64.const 12)) (then unreachable))
    (local.set $buckets (call $buckets (local.get $root)))
    (if (i64.lt_u (local.get $buckets) (i64.const 8)) (then unreachable))
    (if (i64.gt_u (local.get $buckets) (i64.const 4096)) (then unreachable))
    (if (i64.ne (i64.and (local.get $buckets) (i64.sub (local.get $buckets) (i64.const 1))) (i64.const 0)) (then unreachable))
    (if (i64.gt_u (call $count (local.get $root)) (i64.sub (local.get $buckets) (i64.shr_u (local.get $buckets) (i64.const 2)))) (then unreachable))
    (if (i64.gt_u (i64.add (call $start (local.get $root)) (local.get $buckets)) (call $elements)) (then unreachable)))
  (func $roots (param $a i64) (param $b i64)
    (call $shape (local.get $a)) (call $shape (local.get $b))
    (if (i32.eqz (i32.or
      (i64.le_u (i64.add (call $start (local.get $a)) (call $buckets (local.get $a))) (call $start (local.get $b)))
      (i64.le_u (i64.add (call $start (local.get $b)) (call $buckets (local.get $b))) (call $start (local.get $a))))) (then unreachable)))
  (func $static_header
    (if (i64.ne (i64.load (i32.const 65536)) (i64.const 0x3130303050414d4e)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65544)) (i64.const 4)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65552)) (i64.const 131072)) (then unreachable))
    (if (i32.eqz (i32.or
      (i32.or (i64.eq (i64.load (i32.const 65560)) (i64.const 24576)) (i64.eq (i64.load (i32.const 65560)) (i64.const 49152)))
      (i32.or (i64.eq (i64.load (i32.const 65560)) (i64.const 98304)) (i64.eq (i64.load (i32.const 65560)) (i64.const 196608))))) (then unreachable))
    (if (i64.ne (i64.extend_i32_u (memory.size))
      (i64.shr_u (i64.add (i64.const 196607) (i64.load (i32.const 65560))) (i64.const 16))) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65592)) (i64.const 24)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65600)) (i64.const 8)) (then unreachable))
    (if (i64.ne (i64.load (i32.const 65608)) (i64.const 1)) (then unreachable)))
  (func $admit
    (call $static_header)
    (if (i64.ne (i64.load (i32.const 65584)) (i64.const 1)) (then unreachable))
    (call $roots (i64.load (i32.const 65568)) (i64.load (i32.const 65576))))
  (func $claim (result i32)
    (if (i32.ne (global.get $phase) (i32.const 1)) (then unreachable))
    (call $admit)
    (i64.store (i32.const 65584) (i64.const 0))
    (global.set $phase (i32.const 2))
    (i32.const 131072))
  (func $settle (param $result i64) (local $a i64) (local $b i64)
    (if (i32.ne (global.get $phase) (i32.const 2)) (then unreachable))
    (call $static_header)
    (if (i64.ne (i64.load (i32.const 65584)) (i64.const 0)) (then unreachable))
    (local.set $a (i64.and (local.get $result) (i64.const 0xffffffff)))
    (local.set $b (i64.shr_u (local.get $result) (i64.const 32)))
    (call $roots (local.get $a) (local.get $b))
    ;; Rust released both owners and finished the pool before returning these roots.
    (i64.store (i32.const 65568) (local.get $a))
    (if (i32.eq (global.get $failure) (i32.const 2)) (then unreachable))
    (i64.store (i32.const 65576) (local.get $b))
    (if (i32.eq (global.get $failure) (i32.const 3)) (then unreachable))
    (i64.store (i32.const 65584) (i64.const 1))
    (global.set $phase (i32.const 1))
    (if (i32.eq (global.get $failure) (i32.const 4)) (then unreachable)))
  (func $run (param $operation i32) (param $argument i64) (param $fail i32)
    (call $run_pair (local.get $operation) (i64.and (local.get $argument) (i64.const 0xffffffff))
      (i64.shr_u (local.get $argument) (i64.const 32)) (local.get $fail)))
  (func $run_pair (param $operation i32) (param $key i64) (param $value i64) (param $fail i32) (local $root i64)
    (if (i32.ne (global.get $operation) (i32.const -1)) (then unreachable))
    (call $admit)
    (global.set $operation (local.get $operation))
    (global.set $failure (local.get $fail))
    (local.set $root (call $native_step
      (i32.wrap_i64 (i64.load (i32.const 65568)))
      (i32.wrap_i64 (i64.load (i32.const 65576)))
      (i32.or (local.get $operation) (i32.shl (i32.wrap_i64 (call $elements)) (i32.const 16))) (local.get $key) (local.get $value)))
    (if (i32.eq (local.get $fail) (i32.const 1)) (then unreachable))
    (call $settle (local.get $root))
    (global.set $failure (i32.const 0))
    (global.set $operation (i32.const -1)))
  (func (export "canister_init")
    (memory.fill (i32.const 131072) (i32.const 0) (i32.const 24576))
    (i64.store (i32.const 65536) (i64.const 0x3130303050414d4e))
    (i64.store (i32.const 65544) (i64.const 4))
    (i64.store (i32.const 65552) (i64.const 131072))
    (i64.store (i32.const 65560) (i64.const 24576))
    (i64.store (i32.const 65568) (i64.const __ROOT_A__))
    (i64.store (i32.const 65576) (i64.const __ROOT_B__))
    (i64.store (i32.const 65584) (i64.const 1))
    (i64.store (i32.const 65592) (i64.const 24))
    (i64.store (i32.const 65600) (i64.const 8))
    (i64.store (i32.const 65608) (i64.const 1))
    (global.set $phase (i32.const 1))
    (call $run (i32.const 0) (i64.const 0) (i32.const 0)))
  (func __PRE_EXPORT__ (call $run (i32.const 0) (i64.const 0) (i32.const 0)))
  (func (export "canister_post_upgrade")
    (call $admit) (global.set $phase (i32.const 1))
    (call $run (i32.const 0) (i64.const 0) (i32.const 0))
    __POST_POOL_FAILURE__
    __POST_FAILURE__)
  ;; No Rust owner, reference or allocator is live here. Revalidate both roots
  ;; before changing capacity; then initialize only the newly admitted tail.
  (func $expand_pool (param $fault i32) (result i32)
    (local $old i32) (local $new i32) (local $pages i32)
    (if (i32.ne (global.get $phase) (i32.const 1)) (then unreachable))
    (if (i32.ne (global.get $operation) (i32.const -1)) (then unreachable))
    (call $run (i32.const 0) (i64.const 0) (i32.const 0))
    (local.set $old (i32.wrap_i64 (i64.load (i32.const 65560))))
    (if (i32.eq (local.get $old) (i32.const 196608)) (then (return (i32.const 0))))
    (local.set $new (i32.mul (local.get $old) (i32.const 2)))
    (local.set $pages (i32.shr_u (i32.add (i32.const 196607) (local.get $new)) (i32.const 16)))
    (if (i32.gt_u (local.get $pages) (memory.size))
      (then (if (i32.eq (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const -1))
        (then (return (i32.const 0))))))
    (if (i32.eq (local.get $fault) (i32.const 1)) (then unreachable))
    (memory.fill (i32.add (i32.const 131072) (local.get $old)) (i32.const 0) (i32.sub (local.get $new) (local.get $old)))
    (if (i32.eq (local.get $fault) (i32.const 2)) (then unreachable))
    (i64.store (i32.const 65560) (i64.extend_i32_u (local.get $new)))
    (if (i32.eq (local.get $fault) (i32.const 3)) (then unreachable))
    (call $run (i32.const 0) (i64.const 0) (i32.const 0))
    (if (i32.eq (local.get $fault) (i32.const 4)) (then unreachable))
    (i32.const 1))
  (func (export "canister_update pool_grow")
    (if (i32.ne (call $expand_pool (i32.const 0)) (i32.const 1)) (then unreachable)) (call $reply))
  (func (export "canister_update pool_refuse")
    (if (i32.ne (call $expand_pool (i32.const 0)) (i32.const 0)) (then unreachable)) (call $reply))
  (func $fill (param $id i32) (local $limit i64)
    (local.set $limit (call $buckets (i64.load (i32.add (i32.const 65568) (i32.mul (local.get $id) (i32.const 8))))))
    (local.set $limit (i64.sub (local.get $limit) (i64.shr_u (local.get $limit) (i64.const 2))))
    (call $run (i32.add (i32.const 11) (i32.shl (local.get $id) (i32.const 8)))
      (i64.shl (local.get $limit) (i64.const 32)) (i32.const 0))
    (call $reply))
  (func (export "canister_update fill_a") (call $fill (i32.const 0)))
  (func (export "canister_update fill_b") (call $fill (i32.const 1)))
  (func (export "canister_update duplicate_claim") (drop (call $claim)) (drop (call $claim)) (call $reply))
  (func (export "canister_update settle_without_claim") (call $settle (i64.const 0)) (call $reply))
  (func (export "canister_update corrupt") __FAULT__ (call $reply))
  (func (export "canister_query observe")
    (i64.store (i32.const 0) (global.get $version))
    (i64.store (i32.const 8) (i64.extend_i32_u (global.get $phase)))
    (i64.store (i32.const 16) (i64.extend_i32_u (memory.size)))
    (call $reply_data (i32.const 0) (i32.const 24))
    (call $reply_data (i32.const 65536) (i32.const 80))
    (call $reply_data (i32.const 131072) (i32.sub (i32.shl (memory.size) (i32.const 16)) (i32.const 131072)))
    (call $reply))
  __HELPERS_AND_METHODS__
)
