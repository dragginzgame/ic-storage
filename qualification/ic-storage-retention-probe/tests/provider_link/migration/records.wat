;; Native format 3: schema at 65592, counter at 65600, ceiling at 65608.
;; This scalar metadata is outside both Rust domains and the vector payload.
(func $record_shape (local $schema i64)
  (local.set $schema (i64.load (i32.const 65592)))
  (if (i64.ne (local.get $schema) (i64.const __SCHEMA__))
    (then
      (if (i32.eqz (i32.and (i32.ne (i32.const __SOURCE__) (i32.const 0))
            (i32.and (i32.eqz (global.get $phase)) (i64.eq (local.get $schema) (i64.const __SOURCE__)))))
        (then unreachable))))
  ;; A V3 counter occupies four bytes; its following reserved word is canonical zero.
  (if (i64.eq (local.get $schema) (i64.const 3))
    (then (if (i32.ne (i32.load (i32.const 65604)) (i32.const 0)) (then unreachable))))
  (if (i64.eq (local.get $schema) (i64.const 1))
    (then (if (i64.ne (i64.load (i32.const 65608)) (i64.const 0)) (then unreachable)))
    (else (if (i64.gt_u (i64.load (i32.const 65600)) (i64.load (i32.const 65608))) (then unreachable)))))
(func $record_source (export "ncp_record_source") (param $field i32) (result i64)
  (if (i32.eqz (i32.const __SOURCE__)) (then unreachable))
  (if (i32.ne (global.get $phase) (i32.const 0)) (then unreachable))
  (if (i32.ne (global.get $access_operation) (i32.const -1)) (then unreachable))
  (if (i64.ne (i64.load (i32.const 65592)) (i64.const __SOURCE__)) (then unreachable))
  (if (i32.gt_u (local.get $field) (i32.const 1)) (then unreachable))
  (call $admit)
  (i64.load (i32.add (i32.const 65600) (i32.mul (local.get $field) (i32.const 8)))))
(func (export "__bridge_record_source") (drop (call $record_source (i32.const 0))))
(func (export "ncp_record_publish") (param $ceiling i64)
  (if (i64.gt_u (call $record_source (i32.const 0)) (local.get $ceiling)) (then unreachable))
  (if (i32.eq (i32.const __SCHEMA__) (i32.const 3))
    (then
      (if (i64.ne (call $record_source (i32.const 1)) (local.get $ceiling)) (then unreachable))
      (if (i64.gt_u (call $record_source (i32.const 0)) (i64.const 4294967295)) (then unreachable))
      (i32.store (i32.const 65600) (i32.wrap_i64 (call $record_source (i32.const 0))))
      (i32.store (i32.const 65604) (i32.const 0))))
  ;; Exact V3 -> V2 widening. Preserve the admitted ceiling and explicitly
  ;; publish a full-width counter before selecting the target schema.
  (if (i32.eq (i32.const __SOURCE__) (i32.const 3))
    (then
      (if (i32.ne (i32.const __SCHEMA__) (i32.const 2)) (then unreachable))
      (if (i64.ne (call $record_source (i32.const 1)) (local.get $ceiling)) (then unreachable))
      (i64.store (i32.const 65600) (i64.extend_i32_u (i32.load (i32.const 65600))))))
  (i64.store (i32.const 65608) (local.get $ceiling))
  (i64.store (i32.const 65592) (i64.const __SCHEMA__)))
(func (export "ncp_record_schema") (result i32)
  (if (i32.eq (global.get $phase) (i32.const 3)) (then (call $frozen)) (else (call $record_ready)))
  (i32.wrap_i64 (i64.load (i32.const 65592))))
(func (export "ncp_record_ceiling") (result i64)
  (call $frozen) (i64.load (i32.const 65608)))
(func (export "ncp_record_restore") (param $schema i32) (param $ceiling i64)
  (if (i32.ne (global.get $phase) (i32.const 4)) (then unreachable))
  (if (i32.ne (local.get $schema) (i32.const __SCHEMA__)) (then unreachable))
  (if (i32.eq (local.get $schema) (i32.const 1))
    (then (if (i64.ne (local.get $ceiling) (i64.const 0)) (then unreachable)))
    (else (if (i64.gt_u (i64.load (i32.const 65600)) (local.get $ceiling)) (then unreachable))))
  (i64.store (i32.const 65608) (local.get $ceiling))
  (call $static_header))
(func (export "canister_query observe_record")
  (call $reply_data (i32.const 65592) (i32.const 24)) (call $reply))

;; Qualification-only corruption control; not an application operation.
(func (export "canister_update damage_record_padding")
  (if (i32.eq (global.get $phase) (i32.const 3)) (then (call $frozen)) (else (call $record_ready)))
  (if (i64.ne (i64.load (i32.const 65592)) (i64.const 3)) (then unreachable))
  (i32.store (i32.const 65604) (i32.const 1))
  (call $reply))

;; Ordinary updates never run during conversion, vector custody or export.
(func $record_ready
  (if (i32.ne (global.get $phase) (i32.const 1)) (then unreachable))
  (if (i32.ne (global.get $access_operation) (i32.const -1)) (then unreachable))
  (if (i64.lt_u (i64.load (i32.const 65592)) (i64.const 2)) (then unreachable))
  (call $admit))
(func (export "ncp_record_read") (param $field i32) (result i64)
  (call $record_ready)
  (if (i32.gt_u (local.get $field) (i32.const 1)) (then unreachable))
  (if (i32.and (i32.eqz (local.get $field)) (i64.eq (i64.load (i32.const 65592)) (i64.const 3)))
    (then (return (i64.extend_i32_u (i32.load (i32.const 65600))))))
  (i64.load (i32.add (i32.const 65600) (i32.mul (local.get $field) (i32.const 8)))))
(func (export "ncp_record_write") (param $counter i64)
  (call $record_ready)
  (if (i64.gt_u (local.get $counter) (i64.load (i32.const 65608))) (then unreachable))
  (if (i64.eq (i64.load (i32.const 65592)) (i64.const 3))
    (then
      (if (i64.gt_u (local.get $counter) (i64.const 4294967295)) (then unreachable))
      (i32.store (i32.const 65600) (i32.wrap_i64 (local.get $counter))))
    (else (i64.store (i32.const 65600) (local.get $counter)))))
