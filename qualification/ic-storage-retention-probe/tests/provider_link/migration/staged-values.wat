;; Scalar/u64 payload callbacks for the shared staged custody protocol.
(func (export "ncp_stage_begin") (param $counter i64)
  (call $fresh)
  (call $native_init)
  (i64.store (i32.const 65568) (i64.const 0))
  (i64.store (i32.const 65576) (i64.const 0))
  (i64.store (i32.const 65584) (i64.const 3))
  (i64.store (i32.const 65600) (local.get $counter))
  (global.set $phase (i32.const 5))
  (call $staged))
(func (export "ncp_stage_counter") (result i64)
  (call $staged) (i64.load (i32.const 65600)))
(func (export "ncp_stage_value") (param $index i32) (result i64)
  (call $staged)
  (if (i64.ge_u (i64.extend_i32_u (local.get $index)) (i64.load (i32.const 65568))) (then unreachable))
  (i64.load (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 8)))))
(func (export "ncp_stage_put") (param $index i32) (param $value i64)
  (call $staged)
  (if (i64.ne (i64.extend_i32_u (local.get $index)) (i64.load (i32.const 65568))) (then unreachable))
  (if (i32.ge_u (local.get $index) (i32.const 512)) (then unreachable))
  (i64.store (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 8))) (local.get $value))
  (i64.store (i32.const 65568) (i64.extend_i32_u (i32.add (local.get $index) (i32.const 1))))
  (i64.store (i32.const 65576) (i64.load (i32.const 65568))))
(func (export "ncp_stage_damage") (param $mode i32)
  (call $staged)
  (if (i32.gt_u (local.get $mode) (i32.const 3)) (then unreachable))
  (if (i64.eqz (i64.load (i32.const 65568))) (then unreachable))
  (if (i32.eqz (local.get $mode))
    (then
      (i64.store (i32.const 65568) (i64.sub (i64.load (i32.const 65568)) (i64.const 1)))
      (i64.store (i32.const 65576) (i64.load (i32.const 65568)))))
  (if (i32.eq (local.get $mode) (i32.const 1))
    (then (i64.store (i32.const 65600) (i64.xor (i64.load (i32.const 65600)) (i64.const 1)))))
  (if (i32.eq (local.get $mode) (i32.const 2))
    (then (i64.store (i32.const 131072) (i64.xor (i64.load (i32.const 131072)) (i64.const 1)))))
  (if (i32.eq (local.get $mode) (i32.const 3))
    (then (i64.store (i32.const 65576) (i64.add (i64.load (i32.const 65568)) (i64.const 1))))))
