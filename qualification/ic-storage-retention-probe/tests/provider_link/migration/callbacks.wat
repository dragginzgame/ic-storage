;; Scalar-only checkpoint callbacks. No function here can enter either Rust body.
(global $restore_count (mut i32) (i32.const 0))
(func $frozen
  (call $static_header)
  (call $shape (i64.load (i32.const 65568)) (i64.load (i32.const 65576)))
  (if (i32.ne (global.get $phase) (i32.const 3)) (then unreachable))
  (if (i64.ne (i64.load (i32.const 65584)) (i64.const 2)) (then unreachable)))
(func (export "ncp_freeze") (result i32)
  (if (i32.eq (global.get $phase) (i32.const 1))
    (then (call $admit)
      (i64.store (i32.const 65584) (i64.const 2))
      (global.set $phase (i32.const 3))))
  (call $frozen)
  (i32.wrap_i64 (i64.load (i32.const 65568))))
(func (export "ncp_counter") (result i64)
  (call $frozen) (i64.load (i32.const 65600)))
(func (export "ncp_value") (param $index i32) (result i64)
  (call $frozen)
  (if (i64.ge_u (i64.extend_i32_u (local.get $index)) (i64.load (i32.const 65568))) (then unreachable))
  (i64.load (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 8)))))
(func $fresh (export "ncp_fresh") (local $offset i32)
  ;; Ordinary upgrade supplies zeroed native metadata. EOP retained source state
  ;; is refused before any read through a native layout or checkpoint publication.
  (local.set $offset (i32.const 65536))
  (loop $check
    (if (i64.ne (i64.load (local.get $offset)) (i64.const 0)) (then unreachable))
    (local.set $offset (i32.add (local.get $offset) (i32.const 8)))
    (br_if $check (i32.le_u (local.get $offset) (i32.const 65600)))))
(func (export "ncp_begin") (param $counter i64)
  (call $fresh)
  (call $native_init)
  (i64.store (i32.const 65568) (i64.const 0))
  (i64.store (i32.const 65576) (i64.const 0))
  (i64.store (i32.const 65584) (i64.const 0))
  (i64.store (i32.const 65600) (local.get $counter))
  (global.set $phase (i32.const 4))
  (global.set $restore_count (i32.const 0)))
(func (export "ncp_put") (param $index i32) (param $value i64)
  (if (i32.ne (global.get $phase) (i32.const 4)) (then unreachable))
  (if (i32.ne (local.get $index) (global.get $restore_count)) (then unreachable))
  (if (i32.ge_u (local.get $index) (i32.const 512)) (then unreachable))
  (i64.store (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 8))) (local.get $value))
  (global.set $restore_count (i32.add (local.get $index) (i32.const 1))))
(func (export "ncp_finish") (param $length i32)
  (if (i32.ne (global.get $phase) (i32.const 4)) (then unreachable))
  (if (i32.ne (local.get $length) (global.get $restore_count)) (then unreachable))
  (global.set $phase (i32.const 2))
  (call $settle (i64.extend_i32_u (local.get $length)) (i64.extend_i32_u (local.get $length))))
