;; Conversion has no native Rust owner. Source fields are admitted as V2 before
;; checkpoint Rust starts; the V3 Vec is issued only after final publication.
(global $conversion_length (mut i32) (i32.const 0))
(global $conversion_capacity (mut i64) (i64.const 0))
(global $conversion_written (mut i32) (i32.const 0))
(func $v2_source
  (call $static_header)
  __V2_SCHEMA_CHECKS__
  (if (i64.ne (i64.load (i32.const 65584)) (i64.const 1)) (then unreachable))
  (if (i32.ne (global.get $access_operation) (i32.const -1)) (then unreachable))
  (call $shape (i64.load (i32.const 65568)) (i64.load (i32.const 65576)))
  (call $v2_values (i32.wrap_i64 (i64.load (i32.const 65568)))))
(func $v2_values (param $length i32) (local $index i32) (local $address i32)
  (block $done (loop $values
    (br_if $done (i32.ge_u (local.get $index) (local.get $length)))
    (local.set $address (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 16))))
    (if (i64.gt_u (i64.load (local.get $address)) (i64.load offset=8 (local.get $address))) (then unreachable))
    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $values))))
(func (export "__bridge_vector_source")
  (if (i32.ne (global.get $phase) (i32.const 0)) (then unreachable))
  (call $v2_source)
  (global.set $conversion_length (i32.wrap_i64 (i64.load (i32.const 65568))))
  (global.set $conversion_capacity (i64.load (i32.const 65576)))
  (global.set $phase (i32.const 5)))
(func (export "ncp_convert_count") (result i32)
  (if (i32.ne (global.get $phase) (i32.const 5)) (then unreachable))
  (call $v2_source)
  (global.get $conversion_length))
(func (export "ncp_convert_value") (param $index i32) (param $field i32) (result i64)
  (if (i32.ne (global.get $phase) (i32.const 5)) (then unreachable))
  (if (i32.ge_u (local.get $index) (global.get $conversion_length)) (then unreachable))
  (if (i32.gt_u (local.get $field) (i32.const 1)) (then unreachable))
  (i64.load (i32.add (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 16)))
    (i32.mul (local.get $field) (i32.const 8)))))
(func (export "ncp_convert_begin")
  (if (i32.ne (global.get $phase) (i32.const 5)) (then unreachable))
  (call $v2_source)
  (i64.store (i32.const 65584) (i64.const 0))
  (global.set $phase (i32.const 6)))
(func (export "ncp_convert_put") (param $index i32) (param $counter i32) (param $ceiling i64)
  (local $address i32)
  (if (i32.ne (global.get $phase) (i32.const 6)) (then unreachable))
  (if (i32.ne (local.get $index) (global.get $conversion_written)) (then unreachable))
  (if (i32.ge_u (local.get $index) (global.get $conversion_length)) (then unreachable))
  (if (i64.gt_u (i64.extend_i32_u (local.get $counter)) (local.get $ceiling)) (then unreachable))
  (local.set $address (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 16))))
  ;; End the non-owning predecessor field representation, including the upper
  ;; counter word. This is a checked logical replacement, not a Vec cast.
  (i64.store (local.get $address) (i64.extend_i32_u (local.get $counter)))
  (i64.store offset=8 (local.get $address) (local.get $ceiling))
  (global.set $conversion_written (i32.add (local.get $index) (i32.const 1))))
(func (export "ncp_convert_finish")
  (if (i32.ne (global.get $phase) (i32.const 6)) (then unreachable))
  (if (i32.ne (global.get $conversion_written) (global.get $conversion_length)) (then unreachable))
  (call $elements_admit (i64.extend_i32_u (global.get $conversion_length)))
  ;; Only the version and counter width change. Keep base, capacity, length,
  ;; order, ceilings and unused slots; no owning edge or destructor is involved.
  (i64.store (i32.const 65600) (i64.const 3))
  (i64.store (i32.const 65648) (i64.const 4))
  (global.set $phase (i32.const 2))
  (call $settle (i64.extend_i32_u (global.get $conversion_length)) (global.get $conversion_capacity)))
