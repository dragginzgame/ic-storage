;; V3 fields under the shared durable prefix/settlement state machine.
(func (export "ncp_stage_begin")
  (call $fresh) (call $native_init)
  (i64.store (i32.const 65568) (i64.const 0))
  (i64.store (i32.const 65576) (i64.const 0))
  (i64.store (i32.const 65584) (i64.const 3))
  (global.set $phase (i32.const 5)) (call $staged))
(func (export "ncp_stage_value") (param $index i32) (param $field i32) (result i64)
  (local $address i32)
  (call $staged)
  (if (i64.ge_u (i64.extend_i32_u (local.get $index)) (i64.load (i32.const 65568))) (then unreachable))
  (if (i32.gt_u (local.get $field) (i32.const 1)) (then unreachable))
  (local.set $address (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 16))))
  (if (i32.eqz (local.get $field)) (then (return (i64.extend_i32_u (i32.load (local.get $address))))))
  (i64.load offset=8 (local.get $address)))
(func (export "ncp_stage_put") (param $index i32) (param $counter i32) (param $ceiling i64)
  (local $address i32)
  (call $staged)
  (if (i64.ne (i64.extend_i32_u (local.get $index)) (i64.load (i32.const 65568))) (then unreachable))
  (if (i32.ge_u (local.get $index) (i32.const 16)) (then unreachable))
  (if (i64.gt_u (i64.extend_i32_u (local.get $counter)) (local.get $ceiling)) (then unreachable))
  (local.set $address (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 16))))
  (i32.store (local.get $address) (local.get $counter))
  (i64.store offset=8 (local.get $address) (local.get $ceiling))
  (i64.store (i32.const 65568) (i64.extend_i32_u (i32.add (local.get $index) (i32.const 1))))
  (i64.store (i32.const 65576) (i64.load (i32.const 65568))))
;; Deliberate corruption of the unpublished prefix; never a repair operation.
(func (export "ncp_stage_damage") (param $mode i32)
  (call $staged)
  (if (i32.gt_u (local.get $mode) (i32.const 3)) (then unreachable))
  (if (i64.eqz (i64.load (i32.const 65568))) (then unreachable))
  (if (i32.eqz (local.get $mode))
    (then
      (i64.store (i32.const 65568) (i64.sub (i64.load (i32.const 65568)) (i64.const 1)))
      (i64.store (i32.const 65576) (i64.load (i32.const 65568)))))
  (if (i32.eq (local.get $mode) (i32.const 1))
    (then (i64.store (i32.const 131080) (i64.xor (i64.load (i32.const 131080)) (i64.const 1)))))
  (if (i32.eq (local.get $mode) (i32.const 2))
    (then (i32.store (i32.const 131072) (i32.xor (i32.load (i32.const 131072)) (i32.const 1)))))
  (if (i32.eq (local.get $mode) (i32.const 3))
    (then (i64.store (i32.const 65576) (i64.add (i64.load (i32.const 65568)) (i64.const 1))))))
