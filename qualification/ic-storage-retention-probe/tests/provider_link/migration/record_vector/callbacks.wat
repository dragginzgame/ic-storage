;; Scalar-only bridge: none of these callbacks can re-enter native Rust.
(global $restore_count (mut i32) (i32.const 0))
(func $frozen
  (call $static_header) (call $element_header)
  (call $shape (i64.load (i32.const 65568)) (i64.load (i32.const 65576)))
  (call $elements_admit (i64.load (i32.const 65568)))
  (if (i32.ne (global.get $phase) (i32.const 3)) (then unreachable))
  (if (i32.ne (global.get $access_operation) (i32.const -1)) (then unreachable))
  (if (i64.ne (i64.load (i32.const 65584)) (i64.const 2)) (then unreachable)))
(func (export "ncp_freeze") (result i32)
  (if (i32.eq (global.get $phase) (i32.const 1))
    (then
      (call $admit)
      (if (i32.ne (global.get $access_operation) (i32.const -1)) (then unreachable))
      (i64.store (i32.const 65584) (i64.const 2))
      (global.set $phase (i32.const 3))))
  (call $frozen)
  (i32.wrap_i64 (i64.load (i32.const 65568))))
(func (export "ncp_record_value") (param $index i32) (param $field i32) (result i64)
  (local $address i32)
  (call $frozen)
  (if (i64.ge_u (i64.extend_i32_u (local.get $index)) (i64.load (i32.const 65568))) (then unreachable))
  (if (i32.gt_u (local.get $field) (i32.const 1)) (then unreachable))
  (local.set $address (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 16))))
  (if (i32.eqz (local.get $field))
    (then (return (i64.extend_i32_u (i32.load (local.get $address))))))
  (i64.load offset=8 (local.get $address)))
(func $fresh (export "ncp_fresh") (local $offset i32)
  ;; Explicit replacement must discard the complete metadata, including schema.
  (if (i32.ne (global.get $phase) (i32.const 0)) (then unreachable))
  (local.set $offset (i32.const 65536))
  (loop $check
    (if (i64.ne (i64.load (local.get $offset)) (i64.const 0)) (then unreachable))
    (local.set $offset (i32.add (local.get $offset) (i32.const 8)))
    (br_if $check (i32.lt_u (local.get $offset) (i32.const 65680)))))
(func (export "ncp_begin")
  (call $fresh)
  (call $native_init)
  (i64.store (i32.const 65568) (i64.const 0))
  (i64.store (i32.const 65576) (i64.const 0))
  (i64.store (i32.const 65584) (i64.const 0))
  (global.set $phase (i32.const 4))
  (global.set $restore_count (i32.const 0)))
(func (export "ncp_record_put") (param $index i32) (param $counter i32) (param $ceiling i64)
  (local $address i32)
  (if (i32.ne (global.get $phase) (i32.const 4)) (then unreachable))
  (if (i32.ne (local.get $index) (global.get $restore_count)) (then unreachable))
  (if (i32.ge_u (local.get $index) (i32.const 16)) (then unreachable))
  (if (i64.gt_u (i64.extend_i32_u (local.get $counter)) (local.get $ceiling)) (then unreachable))
  (local.set $address (i32.add (i32.const 131072) (i32.mul (local.get $index) (i32.const 16))))
  (i32.store (local.get $address) (local.get $counter))
  (i64.store offset=8 (local.get $address) (local.get $ceiling))
  (global.set $restore_count (i32.add (local.get $index) (i32.const 1))))
(func (export "ncp_finish") (param $length i32)
  (if (i32.ne (global.get $phase) (i32.const 4)) (then unreachable))
  (if (i32.ne (local.get $length) (global.get $restore_count)) (then unreachable))
  (global.set $phase (i32.const 2))
  (call $settle (i64.extend_i32_u (local.get $length)) (i64.extend_i32_u (local.get $length))))

;; Qualification-only corruption after an independently readable export exists.
(func (export "canister_update damage_frozen")
  (call $frozen)
  (i64.store (i32.const 65600) (i64.const 255))
  (call $reply))
